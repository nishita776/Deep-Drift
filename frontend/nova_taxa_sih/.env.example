# "mock" runs entirely against src/api/mock.ts (no backend needed).
# "http" sends real requests to VITE_API_BASE via src/api/http.ts.
VITE_API_MODE=mock

# Base URL of the FastAPI backend. Only used when VITE_API_MODE=http.
# If the backend runs on a different machine, point this at that host
# (not 127.0.0.1) and make sure its CORS config allows this frontend's origin.
VITE_API_BASE=http://127.0.0.1:8000
